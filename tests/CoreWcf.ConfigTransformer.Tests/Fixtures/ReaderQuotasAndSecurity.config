<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior name="metadata" />
      </serviceBehaviors>
    </behaviors>
    <client>
      <endpoint address="http://localhost/client" binding="basicHttpBinding" contract="Sample.IClient" />
    </client>
    <diagnostics />
    <extensions />
    <protocolMapping />
    <serviceHostingEnvironment />
    <bindings>
      <netTcpBinding>
        <binding name="TcpWithQuotas">
          <readerQuotas maxDepth="64" />
          <reliableSession enabled="true" />
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>
    <services>
      <service name="Sample.Service">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090/Service" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="netTcpBinding" bindingConfiguration="TcpWithQuotas" contract="Sample.IService" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
