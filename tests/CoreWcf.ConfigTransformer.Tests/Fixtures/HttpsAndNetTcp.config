<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="SecureBasic">
          <security mode="Transport" />
        </binding>
      </basicHttpBinding>
    </bindings>
    <services>
      <service name="Sample.Service">
        <host>
          <baseAddresses>
            <add baseAddress="https://localhost:8443/Service" />
            <add baseAddress="net.tcp://localhost:8090/Service" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="SecureBasic" contract="Sample.IService" />
        <endpoint address="" binding="netTcpBinding" contract="Sample.IService" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
