<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.serviceModel>
    <services>
      <service name="Sample.Service">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090/Service" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="netTcpBinding" contract="Sample.IService" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
