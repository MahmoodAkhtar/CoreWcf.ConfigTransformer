<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.serviceModel>
    <services>
      <service name="CoreWcf.ConfigTransformer.SampleHost.Services.EvalService">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8080/EvalService" />
            <add baseAddress="net.tcp://localhost:8090/EvalService" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="basicHttpBinding" contract="CoreWcf.ConfigTransformer.SampleHost.Contracts.IEvalService" />
        <endpoint address="" binding="netTcpBinding" contract="CoreWcf.ConfigTransformer.SampleHost.Contracts.IEvalService" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
